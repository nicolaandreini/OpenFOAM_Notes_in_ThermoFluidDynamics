#!/bin/bash
#------------------------------------------------------------------------------
# Allclean script for Fan-Cooled CPU - CHT Case
#
# Removes all generated files, restoring the case to its original state.
# Only 0.orig/, constant/ (without polyMesh), and system/ survive.
#------------------------------------------------------------------------------

cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/CleanFunctions

echo "========================================"
echo " Cleaning Fan-Cooled CPU CHT case..."
echo "========================================"

# ---- Standard OpenFOAM cleanup ----
# Removes time directories, log files, etc.
cleanCase

# ---- Remove reconstructed 0/ directory ----
# (0.orig/ is preserved as the source of initial conditions)
rm -rf 0

# ---- Remove mesh files ----
# Global polyMesh (created by blockMesh, removed after splitMeshRegions)
rm -rf constant/polyMesh

# Region-specific polyMesh (created by splitMeshRegions)
rm -rf constant/fluid/polyMesh
rm -rf constant/solid/polyMesh

# ---- Remove cell/face sets ----
rm -rf constant/polyMesh/sets
rm -rf constant/fluid/polyMesh/sets
rm -rf constant/solid/polyMesh/sets

# ---- Remove dynamicCode (generated by coded BCs) ----
rm -rf dynamicCode

# ---- Remove parallel decomposition ----
rm -rf processor*

# ---- Remove post-processing data ----
rm -rf postProcessing

# ---- Remove any stray files ----
rm -f nul

echo ""
echo " Done. Case is clean."
echo " Run ./Allrun to start the simulation."
echo ""

#------------------------------------------------------------------------------
